# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/site

# Auth.js v5 — AUTH_SECRET: `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Only this e-mail can sign in to /admin
ADMIN_EMAIL=

# S3 + CloudFront (photos, covers)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
CLOUDFRONT_URL=
CLOUDFRONT_KEY_PAIR_ID=
# PEM on one line, newlines written as \n
CLOUDFRONT_PRIVATE_KEY=

# Contact form e-mail (optional: messages are always stored in the DB)
RESEND_API_KEY=
CONTACT_TO_EMAIL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
