    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "prettier": "^3.6.0",
    "prisma": "6.19.3",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.3.0",
