    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.15.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.7"
