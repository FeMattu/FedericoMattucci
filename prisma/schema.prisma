// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

// Necessario per NextAuth
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // "user" o "admin"
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Schema per i progetti multilingua
model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  published   Boolean  @default(false)
  
  // Metadati non linguistici
  featuredImage String?
  order       Int      @default(0)
  tags        String[] @default([])
  
  // Relazione con traduzioni
  translations Translation[]
  
  // Relazione con immagini
  images      Image[]
}

model Translation {
  id        String   @id @default(cuid())
  projectId String
  language  String   // it, en, ecc.
  key       String   // title, description, etc.
  value     String   @db.Text
  
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, language, key])
}

model Image {
  id          String   @id @default(cuid())
  filename    String
  key         String   @unique // chiave S3
  projectId   String?
  width       Int?
  height      Int?
  altText     String?
  caption     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relazione opzionale con un progetto
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}
